# Copy to secret.env (DO NOT COMMIT) and edit values.
# Docker Compose reads this file via env_file for backend/celery.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=87.228.101.164,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://87.228.101.164,http://localhost:3000,http://127.0.0.1:3000

# Admin account hardening
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Set to 1 ONCE to apply ADMIN_PASSWORD to ADMIN_USERNAME, then remove or set to 0
FORCE_ADMIN_PASSWORD=1

# Disable admin/admin if it ever appears (recommended)
DISABLE_DEFAULT_ADMIN=1

# Optional maintenance
# RESULTS_RETENTION_DAYS=7
# TASK_LOG_MAX_BYTES=10485760
# CREATE_SUPERUSER=1
# ADMIN_EMAIL=admin@example.com
